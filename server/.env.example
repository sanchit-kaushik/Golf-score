# ==========================================
# Digital Heroes Server Environment Variables
# ==========================================

# Server Port (Default is 5001 because port 5000 is occupied)
PORT=5001

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/digital-heroes?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for token signing and verification
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL for CORS origin validation and cookie security
CLIENT_URL=http://localhost:5174

# Node Environment ('development' or 'production')
NODE_ENV=development

# ==========================================
# Razorpay Payment Gateway Configuration
# ==========================================
# Obtain from Razorpay Dashboard -> Settings -> API Keys (Test or Live mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Currency (default: INR, can be set to USD or other supported ISO codes)
RAZORPAY_CURRENCY=INR

# Optional: Razorpay Recurring Subscription Plan IDs (from Subscriptions -> Plans)
# If left blank, the platform automatically uses official standard Checkout Orders
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_YEARLY_PLAN_ID=

# Optional: Razorpay Webhook Secret (from Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=
